/* === Talos Command Center TUI Stylesheet === */

/* --- Base --- */
Screen {
    background: $background;
    color: $foreground;
}

Header {
    background: $surface;
    color: $primary;
    text-style: bold;
}

Footer {
    background: $surface;
    color: $secondary;
}

/* --- Status Labels --- */
#status_label {
    width: 100%;
    content-align: center middle;
    margin: 1;
    color: $primary;
    text-style: bold;
}

.error-msg {
    color: $error;
    text-align: center;
    border: double $error;
    padding: 1 2;
    margin: 2;
}

/* --- Top Bar / Health Bar --- */
#top-bar {
    height: 3;
    width: 100%;
    margin-bottom: 1;
}

.title {
    color: $primary;
    text-style: bold;
}

.stale-warning {
    color: $error;
    background: $surface;
    text-style: bold;
    padding: 0 1;
    margin-left: 2;
}

#health-bar {
    height: 1;
    width: 100%;
    margin-top: 1;
    background: $surface;
    padding: 0 1;
}

.health-label {
    text-style: bold;
    color: $text-muted;
}

/* --- Metric Cards (Dashboard) --- */
Grid {
    grid-size: 3;
    grid-gutter: 1 2;
    margin: 1 0;
    height: 14;
}

MetricCard {
    background: $surface;
    border: tall $secondary-darken-2;
    padding: 1 2;
    height: 100%;
    content-align: center middle;
}

MetricCard:hover {
    border: tall $primary;
    background: $surface-lighten-1;
}

.metric-title {
    color: $secondary;
    text-style: bold;
    width: 100%;
    text-align: center;
    margin-bottom: 1;
}

.metric-value {
    color: $primary;
    text-style: bold;
    width: 100%;
    text-align: center;
}

.metric-value.green { color: $success; }
.metric-value.amber { color: $warning; }
.metric-value.red { color: $error; }

/* --- Audit Screen --- */
#audit_container {
    padding: 1 2;
}

AuditViewer DataTable {
    height: 1fr;
    border: tall $secondary-darken-2;
    margin-top: 1;
}

AuditViewer .title {
    color: $primary;
    text-style: bold;
    margin: 1;
}

.severity-marker {
    text-style: bold;
}

.severity-info { color: $success; }
.severity-warn { color: $warning; }
.severity-error { color: $error; }

/* --- RBAC Screen --- */
#rbac_container {
    padding: 1 2;
    height: 100%;
}

RbacManager TabbedContent {
    height: 1fr;
}

RbacManager DataTable {
    height: 1fr;
    border: tall $secondary-darken-2;
    margin-top: 1;
}

/* --- Admin Glass Panels (shared by Secrets, Config, RBAC, Budgets) --- */
.panel-title {
    color: $primary;
    text-style: bold;
    margin: 1 0;
    padding-left: 1;
}

.rbac-form-panel, .mcp-form-panel {
    background: $surface 40%;
    border: tall $secondary-darken-2;
    padding: 0 1;
    margin-bottom: 1;
    height: 10;
}

.spacer {
    margin-top: 2;
}

GlassPanel {
    background: $surface 40%;
    border: tall $secondary-darken-2;
    padding: 1 2;
    margin-bottom: 1;
}

GlassPanel:focus-within {
    border: tall $primary 60%;
}

/* --- Secrets Screen --- */
#secrets-container {
    padding: 1 2;
    height: 1fr;
    overflow-y: auto;
}

#kek-panel {
    max-height: 12;
}

#rotation-panel {
    max-height: 10;
    border: tall $warning 40%;
}

.secret-form-row,
.secret-actions {
    margin-top: 1;
    height: auto;
}

.secret-form-row Input {
    width: 1fr;
    margin-right: 1;
}

.secret-actions Button {
    margin-right: 1;
}

.mcp-form-row,
.mcp-actions {
    margin-top: 1;
    height: auto;
}

.mcp-form-row Input {
    width: 1fr;
    margin-right: 1;
}

.mcp-actions Button {
    margin-right: 1;
}

.kek-row {
    margin: 0 0 1 0;
    height: auto;
    align: left middle;
}

.kek-info, .kek-stats {
    margin: 0 1;
    height: 1;
}

.rotation-stats {
    height: 1;
    margin-top: 1;
}

.rotation-stats Static {
    margin-right: 3;
}

#secrets-table {
    height: 1fr;
    margin-top: 1;
    border: tall $secondary-darken-2;
}

SecretsManager Button#btn-rotate {
    margin-top: 1;
    width: auto;
}

/* --- Config Screen --- */
#config-container {
    padding: 1 2;
    height: 1fr;
}

#config-title {
    margin-bottom: 1;
}

#config-tabs {
    height: 1fr;
}

ConfigManager TabbedContent {
    height: 1fr;
}

ConfigManager DataTable {
    height: 1fr;
    margin-top: 1;
    border: tall $secondary-darken-2;
}

#raw-scroll {
    height: 1fr;
    overflow-y: auto;
    border: tall $secondary-darken-2;
    padding: 1 2;
}

#config-json {
    color: $secondary;
}

/* --- Shared Form Elements --- */
.label {
    width: 20;
    color: $text-muted;
    text-style: bold;
}

.value {
    color: $foreground;
}

.mono-small {
    color: $secondary;
}

.amber {
    color: $warning;
}

DataTable > .datatable--cursor {
    background: $primary 20%;
    color: $foreground;
}

DataTable > .datatable--hover {
    background: $surface;
}

/* --- Inspector Modal --- */

#inspect-backdrop {
    align: center middle;
    background: rgba(0, 0, 0, 0.7);
}

#inspect-dialog {
    width: 80%;
    height: 80%;
    background: $surface;
    border: thick $primary;
    padding: 1 2;
}

#inspect-title {
    width: 100%;
    text-align: center;
    color: $primary;
    text-style: bold;
    margin-bottom: 1;
}

.inspect-scroll {
    height: 1fr;
    border: solid $secondary;
    margin-bottom: 1;
    background: $background;
}

#inspect-content {
    padding: 1;
    color: $foreground;
}

#btn-inspect-close {
    width: 100%;
}

#banners {
    width: auto;
    align: right middle;
}

.security-warning {
    background: $error;
    color: white;
    padding: 0 1;
    margin-left: 2;
    text-style: bold;
    border: tall $error-lighten-1;
}
