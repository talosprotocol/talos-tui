/* === Talos Command Center TUI Stylesheet === */

/* --- Base --- */
Screen {
    background: $background;
    color: $foreground;
}

Header {
    background: $surface;
    color: $primary;
    text-style: bold;
}

Footer {
    background: $surface;
    color: $secondary;
}

/* --- Status Labels --- */
#status_label {
    width: 100%;
    content-align: center middle;
    margin: 1;
    color: $primary;
    text-style: bold;
}

.error-msg {
    color: $error;
    text-align: center;
    border: double $error;
    padding: 1 2;
    margin: 2;
}

/* --- Top Bar / Health Bar --- */
#top-bar {
    height: 3;
    width: 100%;
    margin-bottom: 1;
}

.title {
    color: $primary;
    text-style: bold;
}

.stale-warning {
    color: $error;
    background: $surface;
    text-style: bold;
    padding: 0 1;
    margin-left: 2;
}

#health-bar {
    height: 1;
    width: 100%;
    margin-top: 1;
    background: $surface;
    padding: 0 1;
}

.health-label {
    text-style: bold;
    color: $text-muted;
}

/* --- Metric Cards (Dashboard) --- */
MetricCard {
    background: $surface;
    border: tall $secondary-darken-2;
    padding: 1 2;
    height: 100%;
}

MetricCard:hover {
    border: tall $primary;
}

.metric-title {
    color: $text-muted;
    text-style: bold;
    margin-bottom: 1;
}

.metric-value-container {
    width: 100%;
    content-align: center middle;
}

.metric-value {
    color: $accent;
    text-style: bold;
}

/* --- Audit Screen --- */
#audit_container {
    padding: 1 2;
}

AuditViewer DataTable {
    height: 1fr;
    border: tall $secondary-darken-2;
    margin-top: 1;
}

AuditViewer .title {
    color: $primary;
    text-style: bold;
    margin: 1;
}

.severity-marker {
    text-style: bold;
}

.severity-info { color: $success; }
.severity-warn { color: $warning; }
.severity-error { color: $error; }

/* --- RBAC Screen --- */
#rbac_container {
    padding: 1 2;
    height: 100%;
}

RbacManager TabbedContent {
    height: 1fr;
}

RbacManager DataTable {
    height: 1fr;
    border: tall $secondary-darken-2;
    margin-top: 1;
}

/* --- Admin Glass Panels (shared by Secrets, Config) --- */
.panel-title {
    color: $primary;
    text-style: bold;
    margin: 1 0;
    padding-left: 1;
}

.spacer {
    margin-top: 2;
}

GlassPanel {
    background: $surface 40%;
    border: tall $secondary-darken-2;
    padding: 1 2;
    margin-bottom: 1;
}

GlassPanel:focus-within {
    border: tall $primary 60%;
}

/* --- Secrets Screen --- */
#secrets-container {
    padding: 1 2;
    height: 1fr;
    overflow-y: auto;
}

#kek-panel {
    max-height: 12;
}

#rotation-panel {
    max-height: 10;
    border: tall $warning 40%;
}

.kek-row {
    margin: 0 0 1 0;
    height: auto;
    align: left middle;
}

.kek-info, .kek-stats {
    margin: 0 1;
    height: 1;
}

.rotation-stats {
    height: 1;
    margin-top: 1;
}

.rotation-stats Static {
    margin-right: 3;
}

#secrets-table {
    height: 1fr;
    margin-top: 1;
    border: tall $secondary-darken-2;
}

SecretsManager Button#btn-rotate {
    margin-top: 1;
    width: auto;
}

/* --- Config Screen --- */
#config-container {
    padding: 1 2;
    height: 1fr;
}

#config-title {
    margin-bottom: 1;
}

#config-tabs {
    height: 1fr;
}

ConfigManager TabbedContent {
    height: 1fr;
}

ConfigManager DataTable {
    height: 1fr;
    margin-top: 1;
    border: tall $secondary-darken-2;
}

#raw-scroll {
    height: 1fr;
    overflow-y: auto;
    border: tall $secondary-darken-2;
    padding: 1 2;
}

#config-json {
    color: $secondary;
}

/* --- Shared Form Elements --- */
.label {
    width: 20;
    color: $text-muted;
    text-style: bold;
}

.value {
    color: $foreground;
}

.mono {
    font-family: "Courier New", Courier, monospace;
}

.mono-small {
    color: $secondary;
}

.amber {
    color: $warning;
}

/* --- DataTable Global --- */
DataTable {
    zebra_stripes: true;
}

DataTable > .datatable--cursor {
    background: $primary 20%;
    color: $foreground;
}

DataTable > .datatable--hover {
    background: $surface;
}
